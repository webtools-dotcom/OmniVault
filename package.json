{
  "name": "omnivault",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node scripts/verify.mjs",
    "build:release": "tauri build --no-bundle",
    "package:windows": "node scripts/package_windows.mjs",
    "build:android": "node scripts/build_android.mjs",
    "build:android:debug": "cargo tauri android build --target aarch64 --apk --debug",
    "package:android": "node scripts/package_android.mjs",
    "tauri": "tauri",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,html}\" \"docs/**/*.md\" README.md && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,html}\" \"docs/**/*.md\" README.md && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint": "tsc --noEmit && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prettier": "3.9.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
