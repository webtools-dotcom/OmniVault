<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's own vault server listens on loopback, and the WebView loads every
  image from it over plain HTTP. A release build sets usesCleartextTraffic to
  false, which blocks exactly that, so every picture in the app rendered as a
  broken thumbnail on a release APK while working on a debug one.

  Rather than turning cleartext back on for everything, this permits it only for
  the loopback addresses the app talks to itself on. Cross-device sync is
  unaffected either way: it runs on raw sockets from Rust, which this policy
  does not govern.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
