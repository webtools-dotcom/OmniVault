# Copy this file to keystore.properties and fill in real values.
# keystore.properties is gitignored and must never be committed.
#
# storeFile may be an absolute path, and should point somewhere OUTSIDE
# this repository so the key cannot be committed by accident.

storeFile=/absolute/path/to/omnivault-release.keystore
storePassword=
keyAlias=omnivault
keyPassword=
