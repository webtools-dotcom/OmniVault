{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniVault",
  "version": "0.2.3",
  "identifier": "com.omnivault.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmniVault",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "OmniVault Team",
    "shortDescription": "Private, local-first cross-device sync workspace",
    "longDescription": "Private, local-first cross-device personal workspace and knowledge vault with nested folders, instant capture, and asynchronous store-and-forward mesh synchronization over local Wi-Fi."
  }
}
